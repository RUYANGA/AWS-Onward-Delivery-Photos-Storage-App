# Local runs only: copy to .env (git-ignored, never copied into the image).
# In AWS these values come from SSM Parameter Store, /onward/<env>/app/<NAME>, created by the
# infra repo (templates/application.yaml); DB_USERNAME and DB_PASSWORD come from the
# RDS-managed secret in Secrets Manager. ECS injects both when a task starts.

# Parameter Store
AWS_REGION=eu-west-1
PHOTO_BUCKET=onward-local-photos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=photos
DB_SSLMODE=disable
MAX_UPLOAD_MB=15
STUDENT_NAME="Merci RUYANGA"
LAB_NAME="Storing and Serving Delivery Photos for Onward Logistics"
APP_ENV=local

ADMIN_EMAIL=
ADMIN_NAME=

# Secrets Manager
DB_USERNAME=photos
DB_PASSWORD=photos-local-only
SECRET_KEY=
ADMIN_PASSWORD=

# Local only
S3_ENDPOINT_URL=http://localhost:4566
